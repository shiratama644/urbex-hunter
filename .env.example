# urbex-hunter — environment template
# コピーして .env にリネームし、値を埋めてください（.env は Git 追跡外）

# PostgreSQL 接続文字列（未設定でも GeoJSON フォールバックでビルド/起動は可能）
# 例: DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 任意: スクレイピング時の待機・並列度（未設定なら既定 6）
# CONCURRENCY=6
# 任意: 1都道府県あたりの取得件数（未設定なら 16）
# LIMIT_PER_PREF=16
